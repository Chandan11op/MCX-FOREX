{
  "name": "mcx-commodity-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-platform real-time market data platform for MCX commodities",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/web",
    "mcp/*"
  ],
  "scripts": {
    "dev": "npm run dev:api",
    "dev:all": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node services/api/dist/server.js",
    "dev:web": "npm --workspace=apps/web run dev",
    "build:packages": "npx tsc -p packages/shared-types && npx tsc -p packages/shared-utils && npx tsc -p packages/ui && npx tsc -p services/market-data && npx tsc -p services/export && npx tsc -p services/api",
    "build": "npm run build:packages && npm --workspace=apps/web run build",
    "test": "npm run build:packages && npx tsc -p test && node --test test/unit.test.js test/e2e.test.js test/mcp.test.js",
    "start": "node services/api/dist/server.js"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/ws": "^8.5.10",
    "autoprefixer": "^10.6.1",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "debug": "^4.4.3",
    "decimal.js-light": "^2.5.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "fast-equals": "^6.0.3",
    "helmet": "^7.1.0",
    "iconv-lite": "^0.7.3",
    "object-inspect": "^1.13.4",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "recharts-scale": "^0.4.5",
    "side-channel": "^1.1.1",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.3",
    "victory-vendor": "^37.3.6",
    "vite": "^5.1.4",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  }
}
