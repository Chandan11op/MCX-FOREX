{
  "name": "mcx-forex-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Professional MCX commodity market-data web application monorepo",
  "workspaces": [
    "apps/*",
    "server"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:server": "npm --prefix server run dev",
    "build:web": "npm --prefix apps/web run build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:server && npm run build:web"
  },
  "keywords": [
    "mcx",
    "commodity",
    "market-data",
    "bhavcopy",
    "financial-terminal"
  ],
  "author": "",
  "license": "ISC"
}
