# Server Configuration
NODE_ENV=development
PORT=4000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/mcx_forex

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Market Data Configuration
# Options: mcx-bhavcopy, mock
DATA_PROVIDER=mcx-bhavcopy
DATA_ACCESS_MODE=prototype
DATA_UPDATE_INTERVAL_MS=3600000

# Storage Locations
MCX_DATA_DIRECTORY=./data/mcx

# Security Secrets (Backend only)
JWT_SECRET=your_jwt_secret_key_here
ADMIN_API_KEY=your_admin_api_key_here
