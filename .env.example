# ==============================================================================
# MCX COMMODITY LIVE MARKET PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Market Data Provider Configuration
# Options: 'mock' | 'upstox' | 'dhan' | 'truedata'
DATA_PROVIDER=mock

# Data Access Compliance Mode
# Options: 'prototype' | 'licensed_production'
# WARNING: 'licensed_production' requires active redistribution contracts with MCX / authorized distributor
DATA_ACCESS_MODE=prototype

# Provider Secrets (Upstox POC Adapter)
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:4000/api/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=

# Realtime & Reliability Settings
MARKET_DATA_RECONNECT_MS=1000
LIVE_LATENCY_TARGET_MS=1000
STALE_TICK_THRESHOLD_MS=5000
HEARTBEAT_INTERVAL_MS=10000

# Storage & Caching
# If left empty, API server seamlessly utilizes high-performance in-memory adapters
MONGO_URI=
REDIS_URL=

# Security & Admin Auth
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
ADMIN_API_KEY=admin-dev-secret-key-12345
